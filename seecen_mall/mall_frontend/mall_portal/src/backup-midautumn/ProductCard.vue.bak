<template>
  <article class="product-card" @click="goToDetail">
    <div class="card-image">
      <img :src="product.coverImage || placeholderImage" :alt="product.name" loading="lazy" @error="handleImageError" />
    </div>
    <div class="card-body">
      <div class="card-title">{{ product.name }}</div>
      <div class="card-price-row">
        <span class="current-price">¥{{ formatPrice(product.price) }}</span>
        <span v-if="product.originalPrice && Number(product.originalPrice) > Number(product.price)" class="original-price">
          ¥{{ formatPrice(product.originalPrice) }}
        </span>
      </div>
      <div class="card-meta">
        <span>已售 {{ product.salesCount ?? 0 }}</span>
        <span>库存 {{ product.stock ?? 0 }}</span>
      </div>
    </div>
  </article>
</template>

<script setup>
import { useRouter } from 'vue-router'

const props = defineProps({
  product: {
    type: Object,
    required: true
  }
})

const router = useRouter()

// 占位图（Base64 SVG，标签未渲染）
const placeholderImage = '/placeholder.svg'
function formatPrice(price) {
  if (price == null) return '0.00'
  return Number(price).toFixed(2)
}

function handleImageError(event) {
  if (event.target.src !== placeholderImage) {
    event.target.src = placeholderImage
  }
}

function goToDetail() {
  if (props.product.id) {
    router.push(`/product/${props.product.id}`)
  }
}
</script>

<style scoped>
.product-card {
  background: #ffffff;
  border: 1px solid #ebeef5;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  transition: box-shadow 0.2s, transform 0.2s;
}

.product-card:hover {
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  transform: translateY(-2px);
}

.card-image {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #f5f7fa;
  overflow: hidden;
}

.card-image img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-body {
  padding: 12px;
}

.card-title {
  min-height: 40px;
  color: #303133;
  font-size: 14px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-price-row {
  margin-top: 10px;
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.current-price {
  color: #f56c6c;
  font-size: 18px;
  font-weight: 700;
}

.original-price {
  color: #c0c4cc;
  font-size: 12px;
  text-decoration: line-through;
}

.card-meta {
  margin-top: 6px;
  color: #909399;
  font-size: 12px;
  display: flex;
  gap: 12px;
}
</style>
