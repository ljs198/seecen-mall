<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 配置当前项目的 父工程依赖  -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- 我们自己创建的这个项目的 信息 -->
    <groupId>com.seecen</groupId>
    <artifactId>mall_server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall_server</name>
    <description>mall_server：商城项目的父工程 </description>

    <!-- 父工程的打包方式 修改为 pom -->
    <packaging>pom</packaging>

    <!--  通过坐标引入项目需要的 依赖 -->
    <!-- ==================== 聚合字模块 ==================== -->
    <modules>
        <module>mall_ai</module>
        <module>mall_common</module>
        <module>mall_core</module>
    </modules>


    <!-- ==================== 版本属性集中管理 ==================== -->
    <properties>
        <java.version>21</java.version>                               <!-- Java 版本：JDK 21（与 IDE 项目 SDK 一致） -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>  <!-- 告诉 Maven 用 UTF-8 来读取和编译 .java 源文件 -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>  <!-- 告诉 Maven 生成的报告文件（如站点文档、测试报告等）使用 UTF-8 编码 -->
        <mybatis-plus.version>3.5.16</mybatis-plus.version>            <!-- MyBatis Plus 版本（boot4-starter 需 3.5.15+） -->
        <spring-ai.version>2.0.1</spring-ai.version>                  <!-- Spring AI 版本 -->
        <jjwt.version>0.12.6</jjwt.version>                           <!-- JJWT（JWT令牌）版本 -->
        <hutool.version>5.8.34</hutool.version>                        <!-- Hutool（Java工具类库）版本 -->
    </properties>

    <!-- ==================== 依赖版本统一管理（子模块引用时不指定版本号） ==================== -->
    <dependencyManagement>
        <dependencies>
            <!-- 公共模块：被 mall-admin / mall-portal 依赖 -->
            <dependency>
                <groupId>com.seecen</groupId>
                <artifactId>mall_common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- AI客服模块：被 mall-portal 依赖 -->
            <dependency>
                <groupId>com.seecen</groupId>
                <artifactId>mall_ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- MyBatis Plus：ORM 框架，增强 MyBatis 的 CRUD / 分页 / 逻辑删除能力 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis Plus JSqlParser：分页插件所需的 SQL 解析器（3.5.9+ 需单独引入） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- Spring AI BOM：统一管理 Spring AI 所有模块的版本号 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- JJWT API：JWT 令牌核心 API（生成/解析接口定义） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <!-- JJWT Impl：JWT 令牌运行时实现（签名/验证逻辑） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <!-- JJWT Jackson：JWT 令牌的 JSON 序列化/反序列化支持 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <!-- Hutool：Java 工具类库，提供日期/字符串/集合/加密等常用工具方法（hutool-all 为聚合包） -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ==================== 构建插件 ==================== -->
    <build>
        <plugins>
            <!-- Maven 编译插件：指定 Java 编译版本和源码编码 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source><!-- 源码 Java 版本 -->
                    <target>${java.version}</target><!-- 目标 Java 版本 -->
                    <encoding>UTF-8</encoding><!-- 编译时的源码编码 -->
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ====================
    项目级额外仓库配置
    告诉 Maven "除了默认的中央仓库（settings.xml 中的配置 — "全局仓库基础设施"）还要去这个仓库找依赖"
    ==================== -->
    <repositories>
        <!-- Spring Milestones 仓库：获取 Spring 预发布/Milestone 版本依赖 -->
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

</project>
