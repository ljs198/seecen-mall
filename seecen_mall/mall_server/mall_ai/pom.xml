    <dependencies>
        <!-- 公共模块：引入 mall-common 获得 Web/Security/MyBatis Plus 等基础能力 -->
        <dependency>
            <groupId>com.seecen</groupId>
            <artifactId>mall_common</artifactId>
        </dependency>

        <!-- ============================================================ -->
